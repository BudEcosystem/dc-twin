# Generated by run.sh into its work directory: @NICO_SRC@ is NICo's source at the pinned commit.
[package]
name = "dctwin-nico-fabric-check"
version = "0.1.0"
edition = "2024"
license = "Apache-2.0"
publish = false

[workspace]

[dependencies]
# NICo's NMX-C client, as nvlink-manager uses it (path dependency into NICo at @NICO_REF@)
libnmxc = { path = "@NICO_SRC@/crates/libnmxc" }
# NVIDIA's RMS client crate at the commit the twin's bindings were generated from
librms = { git = "https://github.com/dsx-ai-factory/nv-rms-client.git", rev = "966d7a701d6b0f2b6a4c59a805b1b9c1cbeffb61" }
tokio = { version = "1", features = ["macros", "rt-multi-thread", "time", "process"] }
tonic = { version = "0.14", features = ["tls-ring"] }
serde_json = "1"
