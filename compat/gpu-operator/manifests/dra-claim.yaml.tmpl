# A pod that claims one GPU through Dynamic Resource Allocation (resource.k8s.io/v1, GA in
# Kubernetes 1.34) from the DRA driver's gpu.nvidia.com device class, on one container host.
apiVersion: resource.k8s.io/v1
kind: ResourceClaimTemplate
metadata:
  name: @NAME@
  namespace: dc-twin-gpu
spec:
  spec:
    devices:
      requests:
        - name: gpu
          exactly:
            deviceClassName: gpu.nvidia.com
---
apiVersion: v1
kind: Pod
metadata:
  name: @NAME@
  namespace: dc-twin-gpu
spec:
  restartPolicy: Never
  nodeSelector: { kubernetes.io/hostname: @NODE@ }
  containers:
    - name: app
      image: @IMAGE@
      command: ["sleep", "infinity"]
      resources:
        claims: [{ name: gpu }]
  resourceClaims:
    - name: gpu
      resourceClaimTemplateName: @NAME@
