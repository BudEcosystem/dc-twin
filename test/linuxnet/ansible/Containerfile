# A site's day-0 automation for Cumulus Linux as NVIDIA ships it: ansible-core with NVIDIA's own
# nvidia.nvue collection (Ansible Galaxy), which configures a switch through NVUE's REST API with
# its httpapi connection plugin. TestDay0Ansible runs its modules, unmodified, against the twin's
# emulated NVUE (18 — The first push, D76): the collection is the oracle for the REST interface.
FROM debian:bookworm-slim
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-venv ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/ansible \
 && /opt/ansible/bin/pip install --no-cache-dir ansible-core==2.17.7 \
 && /opt/ansible/bin/ansible-galaxy collection install -p /usr/share/ansible/collections nvidia.nvue ansible.netcommon \
 && mkdir -p /work
ENV PATH=/opt/ansible/bin:$PATH
WORKDIR /work
