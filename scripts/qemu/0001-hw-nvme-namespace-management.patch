+/*
+ * Namespace Management over the subsystem's own backing: a delete detaches the
+ * namespace from every controller and returns its backing to the subsystem as
+ * unallocated capacity; a create allocates a namespace of the requested size
+ * and LBA format from that capacity, unattached, and returns its NSID.
+ */
+static void nvme_ns_mgmt_release(NvmeSubsystem *subsys, NvmeNamespace *ns)
+{
+    uint32_t nsid = ns->params.nsid;
+    int i;
+
+    nvme_ns_drain(ns);
+    for (i = 0; i < NVME_MAX_CONTROLLERS; i++) {
+        NvmeCtrl *ctrl = nvme_subsys_ctrl(subsys, i);
+
+        if (!ctrl || nvme_ns(ctrl, nsid) != ns) {
+            continue;
+        }
+        nvme_detach_ns(ctrl, ns);
+        nvme_update_dsm_limits(ctrl, NULL);
+        if (!test_and_set_bit(nsid, ctrl->changed_nsids)) {
+            nvme_enqueue_event(ctrl, NVME_AER_TYPE_NOTICE,
+                               NVME_AER_INFO_NOTICE_NS_ATTR_CHANGED,
+                               NVME_LOG_CHANGED_NSLIST);
+        }
+    }
+    subsys->namespaces[nsid] = NULL;
+    subsys->unallocated[subsys->nr_unallocated++] = ns;
+}
+
+static uint16_t nvme_ns_mgmt(NvmeCtrl *n, NvmeRequest *req)
+{
+    NvmeSubsystem *subsys = n->subsys;
+    uint32_t nsid = le32_to_cpu(req->cmd.nsid);
+    uint32_t dw10 = le32_to_cpu(req->cmd.cdw10);
+    uint8_t sel = dw10 & 0xf;
+    NvmeNamespace *ns = NULL;
+    NvmeIdNs id = {};
+    uint64_t nsze, ncap;
+    uint16_t ret;
+    int i, slot = -1;
+
+    if (!subsys) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+
+    switch (sel) {
+    case 0x1: /* delete */
+        if (nsid == NVME_NSID_BROADCAST) {
+            for (i = 1; i <= NVME_MAX_NAMESPACES; i++) {
+                ns = nvme_subsys_ns(subsys, i);
+                if (ns) {
+                    nvme_ns_mgmt_release(subsys, ns);
+                }
+            }
+            return NVME_SUCCESS;
+        }
+        ns = nvme_subsys_ns(subsys, nsid);
+        if (!nsid || !ns) {
+            return NVME_INVALID_NSID | NVME_DNR;
+        }
+        nvme_ns_mgmt_release(subsys, ns);
+        return NVME_SUCCESS;
+
+    case 0x0: /* create */
+        ret = nvme_h2c(n, (uint8_t *)&id, sizeof(id), req);
+        if (ret) {
+            return ret;
+        }
+        nsze = le64_to_cpu(id.nsze);
+        ncap = le64_to_cpu(id.ncap);
+        if (!nsze || !ncap || ncap > nsze) {
+            return NVME_INVALID_FIELD | NVME_DNR;
+        }
+        for (i = 0; i < subsys->nr_unallocated; i++) {
+            NvmeNamespace *c = subsys->unallocated[i];
+            uint8_t idx = NVME_ID_NS_FLBAS_INDEX(id.flbas);
+            NvmeLBAF lbaf;
+
+            if (idx > c->id_ns.nlbaf) {
+                return NVME_INVALID_FORMAT | NVME_DNR;
+            }
+            lbaf = c->id_ns.lbaf[idx];
+            if (nsze * ((1ULL << lbaf.ds) + lbaf.ms) <= nvme_ns_capacity(c)) {
+                ns = c;
+                slot = i;
+                break;
+            }
+        }
+        if (!ns) {
+            return NVME_NS_INSUFFICIENT_CAP | NVME_DNR;
+        }
+        for (nsid = 0, i = 1; i <= NVME_MAX_NAMESPACES; i++) {
+            if (!nvme_subsys_ns(subsys, i)) {
+                nsid = i;
+                break;
+            }
+        }
+        if (!nsid) {
+            return NVME_NS_IDNTIFIER_UNAVAIL | NVME_DNR;
+        }
+        subsys->unallocated[slot] = subsys->unallocated[--subsys->nr_unallocated];
+        ns->params.nsid = nsid;
+        ns->id_ns.flbas = id.flbas;
+        ns->lbaf = ns->id_ns.lbaf[NVME_ID_NS_FLBAS_INDEX(id.flbas)];
+        ns->size = nsze * ((1ULL << ns->lbaf.ds) + ns->lbaf.ms);
+        nvme_ns_init_format(ns);
+        subsys->namespaces[nsid] = ns;
+        req->cqe.result = cpu_to_le32(nsid);
+        return NVME_SUCCESS;
+
+    default:
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+}
